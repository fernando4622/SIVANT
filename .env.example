# Plantilla de variables. Copiar a .env y cambiar los valores.
# .env está excluido de Git. Todos los valores de este archivo son ficticios
# y sirven solamente para desarrollo local.

# --- PostgreSQL (compose.yaml y database/init) ---
# Superusuario del contenedor. La aplicación no lo usa.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar-superusuario-local
# Puerto publicado solo en 127.0.0.1. 5433 evita chocar con un PostgreSQL instalado en 5432.
SIVANT_DB_PORT=5433

# --- Conexión de la aplicación ---
SIVANT_DB_HOST=localhost
SIVANT_DB_NAME=sivant
SIVANT_DB_USER=sivant_app
SIVANT_DB_PASSWORD=cambiar-app-local

# --- Aplicación ---
# El perfil dev (ver README) carga cuentas ficticias y permite la cookie sin HTTPS.
SIVANT_HTTP_PORT=8080
# Carpeta de las imágenes de productos (por omisión backend/almacen). En el despliegue, un volumen persistente.
# SIVANT_IMAGENES_DIR=almacen

# Contraseña común de las cuentas ficticias (solo perfil dev). Vacía = no se crean.
SIVANT_DEV_CONTRASENA=Sivant.Local.2026

# --- Primer administrador (perfiles distintos de dev) ---
# Se crea una sola vez si no existe ningún administrador. Retirar tras el primer arranque.
SIVANT_ADMIN_NOMBRE=
SIVANT_ADMIN_CORREO=
SIVANT_ADMIN_CONTRASENA=
